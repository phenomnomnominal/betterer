{
  "name": "@betterer/monorepo",
  "description": "Betterer makes it easier to make incremental improvements to your codebase",
  "license": "MIT",
  "private": true,
  "version": "0.0.0",
  "author": "Craig Spence <craigspence0@gmail.com>",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "api:all": "nx run workspace:api:all",
    "betterer": "node ./packages/cli/bin/betterer --config config/.betterer.ts --results config/.betterer.results",
    "betterer:ci": "node ./packages/cli/bin/betterer ci --config config/.betterer.ts --results config/.betterer.results",
    "betterer:precommit": "node ./packages/cli/bin/betterer precommit --cache --cachePath config/.betterer.cache --config config/.betterer.ts --results config/.betterer.results --repoPath .",
    "build": "nx run workspace:build",
    "build:ci": "nx run workspace:build:ci",
    "build:extension": "nx run workspace:build:extension",
    "build:publish": "nx run workspace:build:publish",
    "clean": "nx run workspace:clean",
    "clean:compile:all": "nx run workspace:clean:compile:all",
    "clean:modules:all": "nx run workspace:clean:modules:all",
    "compile:all": "nx run workspace:compile:all",
    "docs": "nx run workspace:docs",
    "compile:watch": "nx watch --all --includeDependentProjects -- nx run-many -t compile",
    "format:all": "nx run workspace:format:all",
    "lint:all": "nx run workspace:lint:all",
    "release": "nx run workspace:build:publish && nx release",
    "test": "nx run workspace:test",
    "test:api": "nx run workspace:test:api",
    "test:dependencies": "nx run workspace:test:dependencies",
    "test:e2e": "nx run workspace:test:e2e",
    "test:extension": "nx run workspace:test:extension",
    "prepare": "patch-package && husky"
  },
  "devDependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/compiler-cli": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/platform-browser-dynamic": "^20.3.0",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.1",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.9.1",
    "@microsoft/api-extractor": "^7.58.5",
    "@nx/eslint": "^22.6.5",
    "@nx/js": "^22.6.5",
    "@nx/vite": "^22.6.5",
    "@nx/web": "^22.6.5",
    "@phenomnomnominal/commitlint-plugin": "^1.1.1",
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.26",
    "@swc/helpers": "^0.5.21",
    "@types/eslint": "^9.6.1",
    "@types/ignore-walk": "^4.0.3",
    "@types/minimatch": "^5.1.2",
    "@types/node": "^18.19.50",
    "@types/react": "^18.0.12",
    "@vitest/ui": "^2.0.5",
    "eslint": "^9.9.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-n": "^18.1.0",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-require-extensions": "^0.1.3",
    "globals": "^15.9.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "knip": "^5.29.2",
    "lint-staged": "^15.2.10",
    "nx": "^22.6.5",
    "patch-package": "^8.0.1",
    "prettier": "^3.8.3",
    "react": "^17.0.0",
    "rxjs": "^7.8.1",
    "tslib": "^2.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.2",
    "vite": "^5.2.9",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^2.0.5",
    "vitest-monocart-coverage": "^2.1.2",
    "zone.js": "^0.15.0"
  }
}
